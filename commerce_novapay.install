<?php

/**
 * @file
 * Install and update hooks for Commerce NovaPay.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 *
 * @phpstan-return array<string, array<string, mixed>>
 */
function commerce_novapay_schema(): array {
  $schema['commerce_novapay_postback_event'] = [
    'description' => 'Stores non-sensitive NovaPay postback idempotency data.',
    'fields' => [
      'event_key' => [
        'description' => 'SHA-256 hash of the exact raw request body.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
      ],
      'session_id' => [
        'description' => 'NovaPay session identifier.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'gateway_id' => [
        'description' => 'Commerce payment gateway configuration ID.',
        'type' => 'varchar_ascii',
        'length' => 255,
        'not null' => TRUE,
      ],
      'status' => [
        'description' => 'Normalized NovaPay session status.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
      ],
      'received' => [
        'description' => 'Unix timestamp when the event was processed.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'signature_valid' => [
        'description' => 'Whether the event signature was verified.',
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'outcome' => [
        'description' => 'Bounded postback processing outcome.',
        'type' => 'varchar_ascii',
        'length' => 32,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['event_key'],
    'indexes' => [
      'session_gateway' => ['session_id', 'gateway_id'],
      'received' => ['received'],
    ],
  ];

  $schema['commerce_novapay_refund_ledger'] = [
    'description' => 'Stores confirmed item-level NovaPay refunds.',
    'fields' => [
      'refund_id' => [
        'description' => 'Primary identifier.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'payment_id' => [
        'description' => 'Commerce payment identifier.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'order_item_id' => [
        'description' => 'Commerce order item identifier.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'quantity' => [
        'description' => 'Confirmed refunded item quantity.',
        'type' => 'numeric',
        'precision' => 19,
        'scale' => 6,
        'not null' => TRUE,
      ],
      'amount' => [
        'description' => 'Confirmed refunded item amount.',
        'type' => 'numeric',
        'precision' => 19,
        'scale' => 6,
        'not null' => TRUE,
      ],
      'currency_code' => [
        'description' => 'Three-letter currency code.',
        'type' => 'varchar_ascii',
        'length' => 3,
        'not null' => TRUE,
      ],
      'event_key' => [
        'description' => 'SHA-256 hash of the confirming NovaPay evidence.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
      ],
      'confirmed' => [
        'description' => 'Unix timestamp of signed confirmation.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['refund_id'],
    'unique keys' => [
      'event_item' => ['event_key', 'order_item_id'],
    ],
    'indexes' => [
      'payment_item' => ['payment_id', 'order_item_id'],
      'confirmed' => ['confirmed'],
    ],
  ];

  return $schema;
}

/**
 * Installs the NovaPay payment bundle and its fields on existing sites.
 */
function commerce_novapay_update_11001(): void {
  $payment_type_manager = \Drupal::service(
    'plugin.manager.commerce_payment_type',
  );
  $payment_type_manager->clearCachedDefinitions();

  $entity_type = \Drupal::entityTypeManager()->getDefinition(
    'commerce_payment',
  );
  \Drupal::service('entity.bundle_plugin_installer')->installBundles(
    $entity_type,
    ['commerce_novapay'],
  );
}

/**
 * Adds the postback event idempotency journal to existing installations.
 */
function commerce_novapay_update_11003(): void {
  $database_schema = \Drupal::database()->schema();
  $table = 'commerce_novapay_postback_event';
  if (!$database_schema->tableExists($table)) {
    $schema = commerce_novapay_schema();
    $database_schema->createTable($table, $schema[$table]);
  }
}

/**
 * Adds authorization operation metadata fields to existing payments.
 */
function commerce_novapay_update_11004(): void {
  $payment_type_manager = \Drupal::service(
    'plugin.manager.commerce_payment_type',
  );
  $payment_type_manager->clearCachedDefinitions();

  $entity_type = \Drupal::entityTypeManager()->getDefinition(
    'commerce_payment',
  );
  \Drupal::service('entity.bundle_plugin_installer')->installBundles(
    $entity_type,
    ['commerce_novapay'],
  );
}

/**
 * Adds the confirmed refund ledger and pending refund bundle field.
 */
function commerce_novapay_update_11005(): void {
  $database_schema = \Drupal::database()->schema();
  $table = 'commerce_novapay_refund_ledger';
  if (!$database_schema->tableExists($table)) {
    $schema = commerce_novapay_schema();
    $database_schema->createTable($table, $schema[$table]);
  }

  $payment_type_manager = \Drupal::service(
    'plugin.manager.commerce_payment_type',
  );
  $payment_type_manager->clearCachedDefinitions();

  $entity_type = \Drupal::entityTypeManager()->getDefinition(
    'commerce_payment',
  );
  \Drupal::service('entity.bundle_plugin_installer')->installBundles(
    $entity_type,
    ['commerce_novapay'],
  );
}

/**
 * Adds the immutable external operation ID used by partial refunds.
 */
function commerce_novapay_update_11006(): void {
  $payment_type_manager = \Drupal::service(
    'plugin.manager.commerce_payment_type',
  );
  $payment_type_manager->clearCachedDefinitions();

  $entity_type = \Drupal::entityTypeManager()->getDefinition(
    'commerce_payment',
  );
  \Drupal::service('entity.bundle_plugin_installer')->installBundles(
    $entity_type,
    ['commerce_novapay'],
  );
}
